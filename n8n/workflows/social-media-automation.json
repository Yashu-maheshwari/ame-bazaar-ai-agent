        "parameters": {
          "method": "GET",
          "url": "={{`https://www.googleapis.com/drive/v3/files?q='${$env.AME_DRIVE_SOURCE_FOLDER_ID}' in parents and mimeType contains 'image/' and trashed=false&fields=files(id,name,mimeType,modifiedTime,parents)&pageSize=1&orderBy=modifiedTime asc`}}",
          "authentication": "none",
          "responseFormat": "json",
          "sendHeaders": true,
          "headerParametersUi": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "={{'Bearer ' + $node[\"Google - Refresh Token\"].json.access_token}}"
              }
            ]
