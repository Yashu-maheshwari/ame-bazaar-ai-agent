      },
      {
        "parameters": {
          "jsCode": "const candidates = $json.candidates || [];\nconst caption = candidates\n  .flatMap(c => c?.content?.parts || [])\n  .map(p => p?.text || '')\n  .join('\\n')\n  .trim();\n\nif (!caption) {\n  throw new Error('Gemini returned no caption.');\n}\n\nreturn [{\n  json: {\n    caption,\n    captionForPosts: caption,\n    cloudinaryPosterUrl: $node['Code - Prepare Gemini Payload'].json.cloudinaryPosterUrl,\n    fileId: $node['Code - Prepare Gemini Payload'].json.fileId,\n    fileName: $node['Code - Prepare Gemini Payload'].json.fileName,\n    driveDoneFolderId: $node['Code - Prepare Gemini Payload'].json.driveDoneFolderId,\n    driveSourceFolderId: $node['Code - Prepare Gemini Payload'].json.driveSourceFolderId\n  }\n}];\n"
        },
