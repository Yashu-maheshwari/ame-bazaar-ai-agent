    "nodes": [
      {
        "parameters": {
          "content": "AME Bazaar automation map\n\n• Runs 3 times daily (09:00, 14:00, 19:00 Asia/Kolkata)\n• Pulls 1 image from Google Drive source folder\n• Uploads to Cloudinary, adds logo overlay, and builds a premium poster URL\n• Sends poster to Gemini 1.5 Pro Vision for a Hinglish caption\n• Publishes to Instagram, Facebook Page, Threads, and Google Business Profile\n• Moves the source image to the Done folder to prevent duplicates\n\nReplace environment variables before activation:\nCLOUDINARY_CLOUD_NAME\nCLOUDINARY_UPLOAD_PRESET\nCLOUDINARY_LOGO_PUBLIC_ID\nGEMINI_API_KEY\nGOOGLE_DRIVE_ACCESS_TOKEN\nMETA_ACCESS_TOKEN\nTHREADS_ACCESS_TOKEN\nGBP_ACCESS_TOKEN\nAME_DRIVE_SOURCE_FOLDER_ID\nAME_DRIVE_DONE_FOLDER_ID\nIG_USER_ID\nFB_PAGE_ID\nTHREADS_USER_ID\nGBP_ACCOUNT_ID\nGBP_LOCATION_ID\n",
          "height": 460,
          "width": 520,
          "color": 4
        },
        "id": "91888180",
        "name": "Sticky Note - Overview",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 0 9,14,19 * * *"
              }
            ]
          }
        },
        "id": "0b6f70fa",
        "name": "Schedule Trigger - 3x Daily",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1,
        "position": [
          620,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{`https://www.googleapis.com/drive/v3/files?q='${$env.AME_DRIVE_SOURCE_FOLDER_ID}' in parents and mimeType contains 'image/' and trashed=false&fields=files(id,name,mimeType,modifiedTime,parents)&pageSize=1&orderBy=modifiedTime asc`}}",
          "authentication": "none",
          "responseFormat": "json",
          "sendHeaders": true,
          "headerParametersUi": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "={{`Bearer ${$node['Google - Refresh Token'].json.access_token}`}}"
              }
            ]
          }
        },
        "id": "c2e0f503",
        "name": "Drive - List Images",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          860,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const files = $json.files || [];\nif (!files.length) {\n  throw new Error('No unprocessed product image was found in the Google Drive source folder.');\n}\n\nconst file = files[0];\nreturn [{\n  json: {\n    fileId: file.id,\n    fileName: file.name,\n    mimeType: file.mimeType,\n    sourceModifiedTime: file.modifiedTime,\n    driveSourceFolderId: $env.AME_DRIVE_SOURCE_FOLDER_ID,\n    driveDoneFolderId: $env.AME_DRIVE_DONE_FOLDER_ID\n  }\n}];\n"
        },
        "id": "a72be18b",
        "name": "Code - Pick First File",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1100,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{`https://www.googleapis.com/drive/v3/files/${$json.fileId}?alt=media`}}",
          "authentication": "none",
          "responseFormat": "file",
          "dataPropertyName": "data",
          "sendHeaders": true,
          "headerParametersUi": {
            "parameter": [
              {
                "name": "Authorization",
                "value": "={{`Bearer ${$node['Google - Refresh Token'].json.access_token}`}}"
              }
            ]
          }
        },
        "id": "0bbc8d33",
        "name": "Drive - Download Image",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          1340,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{`https://api.cloudinary.com/v1_1/${$env.CLOUDINARY_CLOUD_NAME}/image/upload`}}",
          "authentication": "none",
          "responseFormat": "json",
          "sendBinaryData": true,
          "binaryPropertyName": "data",
          "sendBody": true,
          "bodyContentType": "form-data",
          "bodyParametersUi": {
            "parameter": [
              {
                "name": "upload_preset",
                "value": "={{$env.CLOUDINARY_UPLOAD_PRESET}}"
              },
              {
                "name": "folder",
                "value": "ame-bazaar/raw"
              }
            ]
          }
        },
        "id": "e16846b6",
        "name": "Cloudinary - Upload Original",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          1580,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const cloudName = $env.CLOUDINARY_CLOUD_NAME;\nconst logoId = ($env.CLOUDINARY_LOGO_PUBLIC_ID || '').replace(/\\//g, ':');\nconst publicId = $json.public_id;\n\nif (!cloudName) throw new Error('Missing CLOUDINARY_CLOUD_NAME');\nif (!logoId) throw new Error('Missing CLOUDINARY_LOGO_PUBLIC_ID');\nif (!publicId) throw new Error('Cloudinary upload did not return public_id');\n\nconst posterUrl =\n  `https://res.cloudinary.com/${cloudName}/image/upload/`\n  + `e_improve,q_auto,f_auto,c_fill,g_auto,w_1080,h_1350/`\n  + `l_${logoId},w_220,g_south_east,x_40,y_40/fl_layer_apply/`\n  + `${publicId}`;\n\nreturn [{\n  json: {\n    ...$json,\n    cloudinaryPosterUrl: posterUrl,\n    publicId,\n    baseImageUrl: $json.secure_url\n  }\n}];\n"
        },
        "id": "79bc2917",
        "name": "Code - Build Poster URL",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1820,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{$json.cloudinaryPosterUrl}}",
          "authentication": "none",
          "responseFormat": "file",
          "dataPropertyName": "poster"
        },
        "id": "1fedefb2",
        "name": "Cloudinary - Download Poster",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          2060,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const image = $binary.poster || $binary.data;\nif (!image) {\n  throw new Error('Poster binary not found. Check the Cloudinary download node.');\n}\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, $binary.poster ? 'poster' : 'data');\nconst imageBase64 = buffer.toString('base64');\n\nconst prompt = [\n  'You are the growth marketer for AME Bazaar, a premium family garment retail brand.',\n  'Write a highly engaging Hinglish caption for this image.',\n  'Tone: premium, trustworthy, stylish, warm, conversion-focused.',\n  'Do NOT offer cheap blanket discounts.',\n  'Focus on quality, trust, fit, and store experience.',\n  'Return only the caption text with 8-15 relevant hashtags at the end.'\n].join(' ');\n\nreturn [{\n  json: {\n    prompt,\n    imageBase64: imageBase64,\n    imageMimeType: image.mimeType || 'image/jpeg',\n    cloudinaryPosterUrl: $json.cloudinaryPosterUrl,\n    fileId: $node['Code - Pick First File'].json.fileId,\n    fileName: $node['Code - Pick First File'].json.fileName,\n    driveDoneFolderId: $node['Code - Pick First File'].json.driveDoneFolderId\n  }\n}];\n"
        },
        "id": "d3f891b9",
        "name": "Code - Prepare Gemini Payload",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2300,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${$env.GEMINI_API_KEY}`}}",
          "authentication": "none",
          "responseFormat": "json",
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{JSON.stringify({contents:[{role:'user',parts:[{text:$json.prompt},{inlineData:{mimeType:$json.imageMimeType,data:$json.imageBase64}}]}],generationConfig:{temperature:0.8,maxOutputTokens:300}})}}"
        },
        "id": "7b302d0b",
        "name": "Gemini - Generate Caption",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          2540,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const candidates = $json.candidates || [];\nconst caption = candidates\n  .flatMap(c => c?.content?.parts || [])\n  .map(p => p?.text || '')\n  .join('\\n')\n  .trim();\n\nif (!caption) {\n  throw new Error('Gemini returned no caption.');\n}\n\nreturn [{\n  json: {\n    caption,\n    captionForPosts: caption,\n    cloudinaryPosterUrl: $node['Code - Prepare Gemini Payload'].json.cloudinaryPosterUrl,\n    fileId: $node['Code - Prepare Gemini Payload'].json.fileId,\n    fileName: $node['Code - Prepare Gemini Payload'].json.fileName,\n    driveDoneFolderId: $node['Code - Prepare Gemini Payload'].json.driveDoneFolderId,\n    driveSourceFolderId: $node['Code - Prepare Gemini Payload'].json.driveSourceFolderId\n  }\n}];\n"
        },
