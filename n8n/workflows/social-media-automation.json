      {
        "parameters": {
          "jsCode": "const image = $binary.poster || $binary.data;\nif (!image) {\n  throw new Error('Poster binary not found. Check the Cloudinary download node.');\n}\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, $binary.poster ? 'poster' : 'data');\nconst imageBase64 = buffer.toString('base64');\n\nconst prompt = [\n  'You are the growth marketer for AME Bazaar, a premium family garment retail brand.',\n  'Write a highly engaging Hinglish caption for this image.',\n  'Tone: premium, trustworthy, stylish, warm, conversion-focused.',\n  'Do NOT offer cheap blanket discounts.',\n  'Focus on quality, trust, fit, and store experience.',\n  'Return only the caption text with 8-15 relevant hashtags at the end.'\n].join(' ');\n\nreturn [{\n  json: {\n    prompt,\n    imageBase64: imageBase64,\n    imageMimeType: image.mimeType || 'image/jpeg',\n    cloudinaryPosterUrl: $node['Code - Build Poster URL'].json.cloudinaryPosterUrl,\n    fileId: $node['Code - Pick First File'].json.fileId,\n    fileName: $node['Code - Pick First File'].json.fileName,\n    driveDoneFolderId: $node['Code - Pick First File'].json.driveDoneFolderId\n  }\n}];"
        },
